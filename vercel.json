{
  "buildCommand": "",
  "outputDirectory": "",
  "framework": null,
  "regions": ["cdg1"],
  "env": {
    "SUPABASE_URL": {
      "description": "URL del progetto Supabase"
    },
    "SUPABASE_ANON_KEY": {
      "description": "Chiave anonima di Supabase"
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
